# Redirige http vers https (à garder si le certificat SSL est actif)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Types des fichiers de la carte
AddType image/webp .webp
AddType model/gltf-binary .glb

# Cache : images et modèles 3D gardés 30 jours, pages toujours à jour
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html application/json model/gltf-binary
</IfModule>

# En-têtes de sécurité. OVH envoie par défaut un Permissions-Policy qui liste des fonctions publicitaires
# de Chrome (attribution-reporting, browsing-topics…) inconnues de Brave et Firefox : la console affiche
# alors « Unrecognized feature ». On le remplace par une liste courte, comprise par tous les navigateurs.
<IfModule mod_headers.c>
  Header always unset Permissions-Policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Fichier lu par Chrome avant de précharger le site (/.well-known/traffic-advice) : il doit avoir ce type
<Files "traffic-advice">
  ForceType application/trafficadvice+json
</Files>
